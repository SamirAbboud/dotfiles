#!/usr/bin/env bash

FILE="$XDG_PICTURES_DIR/Screenshots/$(date +"%Y-%m-%d_%H-%M-%S").png"

if [[ "$1" == "--select" ]]; then
    grim -g "$(slurp)" "$FILE"
    STATUS=$?
else
    grim "$FILE"
    STATUS=$?
fi

if [[ $STATUS -eq 0 ]]; then
    wl-copy < "$FILE"

    notify-send \
        --app-name "Screenshot" \
        --icon "$FILE" \
        "New screenshot" "$FILE"

    # loupe "$FILE" &
fi
