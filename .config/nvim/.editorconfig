# .editorconfig

# Global defaults for all files in this project
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Override specifically for Lua files
[*.lua]
indent_size = 2

# JSON & JSONC (JSON with comments) files
[*.{json,jsonc}]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
